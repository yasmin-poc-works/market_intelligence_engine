# ---------- LLM ----------
LLM_PROVIDER=groq
GROQ_API_KEY=
# Default model; per-role models fall back to it when left empty
LLM_MODEL=openai/gpt-oss-120b
PLANNER_MODEL=
RESEARCHER_MODEL=
SYNTHESIS_MODEL=
WRITER_MODEL=
FACT_CHECK_MODEL=
LLM_MAX_CONCURRENCY=3
LLM_MAX_RETRIES=5

# ---------- Embeddings ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- Search ----------
SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=

# ---------- Qdrant ----------
# Embedded local mode (default). Relative paths resolve against the repo root.
QDRANT_PATH=data/qdrant
# Optional: Qdrant Cloud or standalone server. If set, QDRANT_PATH is ignored.
QDRANT_URL=
QDRANT_API_KEY=

# ---------- Storage ----------
DATABASE_URL=sqlite:///data/insightforge.db
SCRATCH_PATH=data/scratch

# ---------- Pipeline ----------
EVIDENCE_TOKEN_BUDGET=6000
MAX_PARALLEL_SUBTASKS=6

# ---------- Web ----------
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
UPLOAD_PATH=data/uploads

# ---------- Auth ----------
JWT_SECRET=change-me

# ---------- Observability (optional) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insightforge
