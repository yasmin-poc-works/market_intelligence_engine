# ---------- LLM ----------
LLM_PROVIDER=groq
GROQ_API_KEY=
# Default model; per-role models fall back to it when left empty
LLM_MODEL=openai/gpt-oss-120b
# Free-tier setup. Groq limits tokens per minute PER MODEL, so synthesis (the highest-volume step) runs on a
# second model. Tested: openai/gpt-oss-20b cannot do structured output here (answers in plain text), so do not use
# it for synthesis, entity or writer roles. Leave a role empty to use LLM_MODEL.
PLANNER_MODEL=
RESEARCHER_MODEL=
SYNTHESIS_MODEL=qwen/qwen3.8-27b
WRITER_MODEL=
FACT_CHECK_MODEL=
ENTITY_MODEL=
LLM_MAX_CONCURRENCY=2
LLM_MAX_RETRIES=8

# ---------- Embeddings ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- Search ----------
SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=

# ---------- Qdrant ----------
# Embedded local mode (default). Relative paths resolve against the repo root.
QDRANT_PATH=data/qdrant
# Optional: Qdrant Cloud or standalone server. If set, QDRANT_PATH is ignored.
QDRANT_URL=
QDRANT_API_KEY=

# ---------- Storage ----------
DATABASE_URL=sqlite:///data/insightforge.db
SCRATCH_PATH=data/scratch

# ---------- Pipeline ----------
EVIDENCE_TOKEN_BUDGET=4000
MAX_PARALLEL_SUBTASKS=3

# ---------- Scheduler ----------
# Runs watchlist items in-process; keep the API at a single worker
SCHEDULER_ENABLED=true

# ---------- Web ----------
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
UPLOAD_PATH=data/uploads

# ---------- Auth ----------
JWT_SECRET=change-me

# ---------- Observability (optional) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insightforge
